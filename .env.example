# ===== 吃饱饱助手 · 环境变量样例 =====
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 排除，切勿提交真实密钥。

# 走云还是走本地：cloud（默认，快、会说人话）/ local（纯离线演示）
MODEL_PROVIDER=cloud

# ---- 云模型（OpenAI 兼容端点，默认 DeepSeek）----
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat
# 留空也不崩：程序会打印红字提示并自动回退本地 Ollama
CLOUD_API_KEY=

# ---- 本地模型（Ollama 的 OpenAI 兼容端点）----
LOCAL_BASE_URL=http://localhost:11434/v1
# 本机没有这个型号时，会自动换成已安装的 qwen 系模型
LOCAL_MODEL=qwen2.5:7b-instruct

# ---- 其他可选 ----
# CHIBAOBAO_PORT=8770        # 起始端口（被占用会自动往后找）
# CHIBAOBAO_NO_WINDOW=1      # 只起服务不开窗口（调试用）
# NO_COLOR=1                 # 关掉控制台红绿字
