# ===== 杉达校园服务智能体 环境变量示例 =====
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 排除，切勿提交真实密钥。

# Ollama 本地模型服务地址（OpenAI 兼容接口）
OLLAMA_BASE_URL=http://localhost:11434/v1
# 使用的模型名（需先在 Ollama 中拉取/存在）
# 本机已装：buding-qwen05b-32k:latest 或 modelscope.cn/Qwen/Qwen2.5-0.5B-Instruct-GGUF:latest
OLLAMA_MODEL=buding-qwen05b-32k:latest
# Ollama 的 OpenAI 兼容接口不校验密钥，填任意非空字符串即可
OPENAI_API_KEY=ollama

# 如需切换到阿里百炼等云端大模型（可选，非必须）：
# OLLAMA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OLLAMA_MODEL=qwen-plus
# OPENAI_API_KEY=你的DashScopeKey
